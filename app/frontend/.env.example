# Copy to .env.local for local overrides. Never commit a real .env file —
# .env and .env.* are gitignored, with only this example tracked.

# The backend API's origin, with no trailing path and no trailing slash.
#
# LEAVE THIS UNSET FOR LOCAL DEVELOPMENT. Unset means requests go to /api/...
# on the Vite dev server, which proxies them to Flask on :5001 (see
# vite.config.js). Setting it locally bypasses that proxy and will usually
# cause CORS errors instead.
#
# In production it is set in Vercel's dashboard, not in a file:
#   VITE_API_URL=https://your-backend.onrender.com
#
# Note: anything prefixed VITE_ is inlined into the JavaScript bundle at build
# time and is therefore PUBLIC. That is correct for this value — it is a public
# API endpoint, configuration rather than a credential. Never put a secret,
# password or key behind a VITE_ prefix.
VITE_API_URL=
