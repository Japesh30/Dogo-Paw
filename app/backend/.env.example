# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.
# No value in this file is a real secret; they are placeholders and examples.

# --- Environment -----------------------------------------------------------
# "development" (default) or "production". This one flag decides whether the
# app is allowed to be permissive: in production a missing SECRET_KEY,
# CORS_ORIGINS or ADMIN_PASSWORD is a startup failure rather than a default.
APP_ENV=development

# --- Secrets ---------------------------------------------------------------
# Required when APP_ENV=production, minimum 32 characters. Leave unset in
# development and a random key is generated into .secret_key (gitignored).
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Password for the seeded admin account. Required when APP_ENV=production
# (minimum 12 characters); defaults to a development-only password otherwise.
# Set this directly in the host's environment settings, never in a file.
ADMIN_PASSWORD=

# --- Database --------------------------------------------------------------
# Unset means a local SQLite file (app/backend/dogopaw.db) — that is what keeps
# local development zero-config. Set it to a PostgreSQL URL for production.
#
# Supabase gives you this under Project Settings -> Database -> Connection
# string. Use the *Session pooler* (port 6543), not the direct connection:
#
#   DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
#
# `postgres://` is accepted too and rewritten automatically, as is a URL with
# no explicit driver. See docs/DATABASE.md.
DATABASE_URL=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of exact origins allowed to call this API from a
# browser. "*" is refused when APP_ENV=production. Unset in development means
# http://localhost:5173 and http://127.0.0.1:5173.
# Production example:
#   CORS_ORIGINS=https://dogo-paw.vercel.app
CORS_ORIGINS=

# --- Server ----------------------------------------------------------------
# The development server's port. Hosts normally inject PORT themselves.
PORT=5001

# Set to "false" only to run the test suite, which would otherwise trip the
# rate limits. Leave it on everywhere else, including development.
RATE_LIMIT_ENABLED=true
